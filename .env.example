# LLM provider: mock | gemini
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

# Model generation parameters (do not hardcode in source)
MODEL_TEMPERATURE=0.2
MODEL_FREQUENCY_PENALTY=0.0
MODEL_PRESENCE_PENALTY=0.0
MODEL_MAX_OUTPUT_TOKENS=4096

# Retrieval
EMBEDDING_CACHE_DIR=data/.cache/embeddings
VECTOR_STORE_BACKEND=memory
CHROMA_PERSIST_DIR=data/.cache/chroma
CONTRACT_COLLECTION=contract_store
LEGAL_COLLECTION=legal_store

# Pipeline
HUMAN_REVIEW_CONFIDENCE_THRESHOLD=0.55
MAX_DEPENDENCY_HOPS=2
MAX_CONTEXT_CLAUSES=24
LOG_LEVEL=INFO

# Paths
LEGAL_KNOWLEDGE_DIR=data/legal_knowledge
SAMPLE_CONTRACT_DIR=data/sample_contracts
PROCESSED_DIR=data/processed
