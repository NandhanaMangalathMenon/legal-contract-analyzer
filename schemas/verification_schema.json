{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerifiedAnalysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "verified_risks",
    "overall_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },

    "document_id": {
      "type": "string"
    },

    "verified_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "risk_id",
          "verification_status",
          "contract_supported",
          "confidence",
          "contract_evidence",
          "legal_sources",
          "reasoning",
          "requires_human_review"
        ],
        "properties": {
          "risk_id": {
            "type": "string"
          },

          "verification_status": {
            "type": "string",
            "enum": [
              "VERIFIED",
              "PARTIALLY_SUPPORTED",
              "UNSUPPORTED",
              "CONTRADICTED",
              "LEGAL_SUPPORT_NOT_FOUND",
              "STATE_LAW_REQUIRED",
              "HUMAN_REVIEW_REQUIRED"
            ]
          },

          "contract_supported": {
            "type": "boolean"
          },

          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },

          "contract_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "clause_id",
                "page",
                "text"
              ],
              "properties": {
                "clause_id": {
                  "type": "string"
                },

                "page": {
                  "type": "integer",
                  "minimum": 1
                },

                "text": {
                  "type": "string"
                }
              }
            }
          },

          "legal_sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_type",
                "name",
                "reference"
              ],
              "properties": {
                "source_type": {
                  "type": "string",
                  "enum": [
                    "central_act",
                    "central_rule",
                    "government_source",
                    "supreme_court_judgment"
                  ]
                },

                "name": {
                  "type": "string"
                },

                "section": {
                  "type": [
                    "string",
                    "null"
                  ]
                },

                "reference": {
                  "type": "string"
                },

                "source_url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uri"
                },

                "relevant_text": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },

          "reasoning": {
            "type": "string"
          },

          "requires_human_review": {
            "type": "boolean"
          }
        }
      }
    },

    "overall_status": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "PARTIALLY_VERIFIED",
        "REQUIRES_HUMAN_REVIEW"
      ]
    }
  }
}
