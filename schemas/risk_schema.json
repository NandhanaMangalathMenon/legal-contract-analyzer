{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RiskAnalysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "risks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },

    "document_id": {
      "type": "string"
    },

    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "risk_id",
          "severity",
          "category",
          "title",
          "clause_ids",
          "explanation",
          "why_it_matters",
          "evidence",
          "questions_for_lawyer"
        ],
        "properties": {
          "risk_id": {
            "type": "string"
          },

          "severity": {
            "type": "string",
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW",
              "INFO"
            ]
          },

          "category": {
            "type": "string",
            "enum": [
              "financial",
              "termination",
              "renewal",
              "liability",
              "indemnification",
              "intellectual_property",
              "privacy_data",
              "confidentiality",
              "non_compete",
              "non_solicitation",
              "exclusivity",
              "dispute_resolution",
              "governing_law",
              "ambiguity",
              "contradiction",
              "obligation",
              "penalty",
              "other"
            ]
          },

          "title": {
            "type": "string"
          },

          "clause_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },

          "explanation": {
            "type": "string"
          },

          "why_it_matters": {
            "type": "string"
          },

          "potential_consequence": {
            "type": [
              "string",
              "null"
            ]
          },

          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "clause_id",
                "page",
                "text"
              ],
              "properties": {
                "clause_id": {
                  "type": "string"
                },

                "page": {
                  "type": "integer",
                  "minimum": 1
                },

                "text": {
                  "type": "string"
                }
              }
            },
            "minItems": 1
          },

          "questions_for_lawyer": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },

          "risk_factors": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "financial_exposure": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },

              "termination_difficulty": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },

              "asymmetry": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },

              "ambiguity": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },

              "obligation_strength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              }
            }
          }
        }
      }
    }
  }
}
