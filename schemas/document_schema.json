{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DocumentAnalysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "filename",
    "document_metadata",
    "parties",
    "clauses"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "document_id": {
      "type": "string"
    },
    "filename": {
      "type": "string"
    },
    "document_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_type",
        "page_count",
        "language",
        "jurisdiction_text"
      ],
      "properties": {
        "file_type": {
          "type": "string"
        },
        "page_count": {
          "type": "integer",
          "minimum": 0
        },
        "language": {
          "type": "string"
        },
        "jurisdiction_text": {
          "type": ["string", "null"]
        }
      }
    },
    "parties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role"],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clause_id",
          "type",
          "text",
          "location"
        ],
        "properties": {
          "clause_id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "title": {
            "type": ["string", "null"]
          },
          "text": {
            "type": "string"
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": ["page_start"],
            "properties": {
              "page_start": {
                "type": "integer",
                "minimum": 1
              },
              "page_end": {
                "type": ["integer", "null"]
              },
              "section": {
                "type": ["string", "null"]
              }
            }
          },
          "entities": {
            "type": "object"
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
